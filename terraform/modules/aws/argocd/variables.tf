# The admin password is generated by Terraform (random_password in main.tf)
# and reaches the chart as its bcrypt hash. Changing this value replaces the
# password and its mtime together, which logs every session out. Any string
# works; a date or a counter keeps the history readable.
variable "argocd_admin_password_rotation" {
  default     = "1"
  description = "Rotation key for the generated ArgoCD admin password. Change it (for example to the date) to generate a new password and invalidate existing sessions."
  type        = string
}

# Pinned in docs/argocd-migration-plan.md (Phase 0 "Versions"). Re-pin only in
# a deliberate upgrade PR, together with that table.
variable "argocd_chart_version" {
  default     = "10.11.6"
  description = "Version of the argo-cd chart from https://argoproj.github.io/argo-helm to install (10.11.6 ships Argo CD v3.5.6)."
  type        = string
}

variable "argocd_namespace" {
  default     = "argocd"
  description = "Namespace to install ArgoCD into. Created by the release."
  type        = string
}
